# Copy to .env and replace these values before starting a fresh stack.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
APIM_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
# Exactly 64 hexadecimal characters (32 bytes); retain with database backups.
APIM_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
